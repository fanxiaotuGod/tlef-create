# Multi-stage build for Node.js backend
# Stage 1: Dependencies
FROM node:20 AS dependencies

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm ci --only=production

# Stage 2: Runtime
FROM node:20

WORKDIR /app

# Create non-root user for security
RUN groupadd --gid 1001 nodejs && \
    useradd --uid 1001 --gid nodejs --shell /bin/bash --create-home nodejs

# Copy dependencies from dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules

# Copy application code
COPY --chown=nodejs:nodejs . .

# Create uploads directory and set permissions
RUN mkdir -p /app/routes/create/uploads /app/local_cache && \
    chown -R nodejs:nodejs /app/routes/create/uploads /app/local_cache

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 8051

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8051/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start the application with explicit entrypoint
ENTRYPOINT []
CMD ["node", "/app/server.js"]
